# See https://help.github.com/articles/ignoring-files/ for more about ignoring file
    
#frontend
/frontend/node_modules
/frontend/dist
/frontend/*.tsbuildinfo
/frontend/.env
/frontend/.env.local
/frontend/next-env.d.ts
/frontend/.next
/frontend/out
/frontend/build
/frontend/.vercel
/frontend/coverage
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*
/frontend/pnpm-debug.log*
/frontend/.eslintcache
/frontend/.DS_Store
/frontend/.vscode
/frontend/.idea
/frontend/*.pem

# backend
/backend/node_modules
/backend/dist
/backend/*.tsbuildinfo
/backend/.env
/backend/.env.local
/backend/coverage
/backend/npm-debug.log*
/backend/yarn-debug.log*
/backend/yarn-error.log*
/backend/pnpm-debug.log*
/backend/.eslintcache
/backend/.DS_Store
/backend/.vscode
/backend/.idea
